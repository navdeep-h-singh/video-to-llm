# Copy to `.env` and edit. `.env` is git-ignored and must never be committed.
#
# Every value here is optional. The application runs entirely locally with no
# environment configuration at all. Nothing in this file is required to process
# a video, produce a transcript, or build a collection.

# ─── Where output goes ────────────────────────────────────────────────────
# Absolute path to the output root. If unset, the first-run screen asks for it
# and stores the choice in the local settings file.
# VIDEO_TO_LLM_OUTPUT_ROOT=

# ─── Localhost binding ────────────────────────────────────────────────────
# The host is fixed to the loopback interface and cannot be changed. Only the
# port is configurable.
# VIDEO_TO_LLM_PORT=8712

# ─── Logging ──────────────────────────────────────────────────────────────
# One of: DEBUG, INFO, WARNING, ERROR
# VIDEO_TO_LLM_LOG_LEVEL=INFO

# ─── Provider credentials ─────────────────────────────────────────────────
# Keys are normally held in the operating system's secure store (macOS Keychain,
# Windows Credential Manager, Linux Secret Service). These variables exist only
# as a process-scoped fallback for machines with no secure store available.
#
# Never commit real values. There is no plaintext on-disk fallback: if you do not
# set these and no secure store is present, external providers stay unavailable
# and local-only processing continues to work.
#
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
# OPENAI_COMPATIBLE_API_KEY=

# ─── Local Ollama ─────────────────────────────────────────────────────────
# No API key exists for Local Ollama and none will ever be requested.
# Loopback hosts only: 127.0.0.1, localhost, ::1. Anything else is rejected.
# OLLAMA_ENDPOINT=http://127.0.0.1:11434
